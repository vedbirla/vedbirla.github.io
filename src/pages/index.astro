---
const title = 'Astro Deployment Test Pt. 2';
const description = 'A simple homepage to test Astro and GitHub Pages deployment.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <main class="container">
      <div class="badge">
        <span class="dot"></span>
        ASTRO DEPLOYMENT TEST
      </div>

      <h1>It works<span class="accent">.</span></h1>

      <p class="subtitle">
        Welcome to my new website. This page was built with Astro and deployed
        using GitHub Actions.
      </p>

      <section class="status">
        <div class="status-icon">✓</div>
        <div>
          <h2>Your site is online</h2>
          <p>If you can read this page, GitHub Pages is serving your site.</p>
        </div>
      </section>

      <div class="checks">
        <div class="check">
          <span>01</span>
          <div>
            <strong>Astro</strong>
            <p>Static site generation</p>
          </div>
        </div>
        <div class="check">
          <span>02</span>
          <div>
            <strong>GitHub Actions</strong>
            <p>Automated deployment</p>
          </div>
        </div>
        <div class="check">
          <span>03</span>
          <div>
            <strong>GitHub Pages</strong>
            <p>Website hosting</p>
          </div>
        </div>
      </div>

      <footer>
        <span>Built with Astro</span>
        <span>·</span>
        <span>My first deployment</span>
      </footer>
    </main>
  </body>
</html>

<style>
  :global(*) {
    box-sizing: border-box;
  }

  :global(body) {
    margin: 0;
    min-height: 100vh;
    background: #0b1020;
    color: #f4f5fb;
    font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont,
      "Segoe UI", sans-serif;
  }

  .container {
    width: min(100% - 40px, 760px);
    margin: 0 auto;
    padding: 110px 0 48px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 9px 13px;
    border: 1px solid #29344b;
    border-radius: 999px;
    color: #b9c5dc;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 1.5px;
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #69e6a6;
    box-shadow: 0 0 12px #69e68080;
  }

  h1 {
    margin: 30px 0 16px;
    font-size: clamp(64px, 12vw, 104px);
    line-height: 1;
    letter-spacing: -7px;
    font-weight: 800;
  }

  .accent {
    color: #a78bfa;
  }

  .subtitle {
    max-width: 550px;
    color: #aab4ca;
    font-size: 18px;
    line-height: 1.8;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 18px;
    margin-top: 42px;
    padding: 24px;
    border: 1px solid #34433f;
    border-radius: 16px;
    background: #121e25;
  }

  .status-icon {
    display: grid;
    flex-shrink: 0;
    width: 42px;
    height: 42px;
    place-items: center;
    border-radius: 12px;
    background: #173c32;
    color: #69e6a6;
    font-size: 24px;
  }

  h2 {
    margin: 0 0 6px;
    font-size: 17px;
  }

  .status p,
  .check p {
    margin: 0;
    color: #aab4ca;
    font-size: 14px;
    line-height: 1.6;
  }

  .checks {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-top: 18px;
  }

  .check {
    padding: 20px 16px;
    border: 1px solid #283149;
    border-radius: 14px;
    background: #11182a;
  }

  .check > span {
    display: block;
    margin-bottom: 20px;
    color: #a78bfa;
    font-size: 12px;
    font-weight: 700;
  }

  .check strong {
    display: block;
    margin-bottom: 7px;
    font-size: 14px;
  }

  footer {
    display: flex;
    gap: 10px;
    margin-top: 56px;
    color: #75819a;
    font-size: 13px;
  }

  @media (max-width: 540px) {
    .container {
      padding-top: 70px;
    }

    h1 {
      letter-spacing: -4px;
    }

    .checks {
      grid-template-columns: 1fr;
    }

    .check {
      padding: 16px;
    }

    .check > span {
      margin-bottom: 10px;
    }
  }
</style>
